@page
@model IndexModel
@{
    ViewData["Title"] = "Lista de stiri";
}

<h1>Stiri</h1>
<p>Numar articole: @ViewData["Count"]</p>
<a asp-page="Articles/Create">Creaza un articol</a>
<table>
     <thead>
         <tr>
             <th>Title</th>
             <th>Date</th>
             <th>Category</th>
        </tr>
     </thead>
     <tbody>
        @* @{
            int? value = null;
            value ??= 30;
            int number = value ?? 20;
        } *@
         @foreach (var article in Model.Articles)
         {
             <tr>
                 <td><a asp-page="Articles/Details" asp-route-id="@article.Id">@article.Title</a></td>
                 <td>@article.PublishedAt.ToShortDateString()</td>
                 <td>@article.Category!.Name</td>
             </tr>
         }
     </tbody>
</table>

